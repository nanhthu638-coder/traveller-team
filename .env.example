PORT=3000
SQLSERVER_SERVER=localhost
SQLSERVER_INSTANCE=SQLEXPRESS
SQLSERVER_DATABASE=TravellerTeam
SQLSERVER_USER=traveller_app
SQLSERVER_PASSWORD=replace-with-a-local-secret
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERT=true

# Emails allowed to sign in as administrators (comma-separated).
# Create an application account using one of these email addresses first.
ADMIN_EMAILS=admin@example.com
