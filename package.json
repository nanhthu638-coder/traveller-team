{
	"name": "traveller-team",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n API,WEB -c green,blue \"npm:dev:server\" \"npm:dev:web\"",
		"dev:server": "node --env-file-if-exists=.env --watch server/index.js",
		"dev:web": "vite --host 0.0.0.0",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env server/index.js"
	},
	"dependencies": {
		"express": "^5.1.0",
		"mssql": "^11.0.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.13",
		"@vitejs/plugin-react": "^5.2.0",
		"concurrently": "^9.2.1",
		"tailwindcss": "^4.1.13",
		"vite": "^7.1.7"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
